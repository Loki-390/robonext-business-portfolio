# ====================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ====================================================================

PORT=5000
NODE_ENV=development

# CLIENT URL FOR CORS
CLIENT_URL=http://localhost:5173

# DATABASE CONFIGURATION (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=robotics_portfolio
DB_PORT=3306

# JWT CONFIGURATION
JWT_SECRET=super_secret_jwt_key_robonext_stem_education_2025_secure
JWT_EXPIRES_IN=7d

# EMAIL / SMTP CONFIGURATION (Nodemailer)
# If left empty, emails will run in test/simulation mode and log to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RoboNext STEM Technologies" <enquiries@robonext.com>
ADMIN_NOTIFICATION_EMAIL=admin@robonext.com

# AUTOMATION SETTINGS
ENABLE_AUTOMATED_FOLLOWUPS=true
FOLLOWUP_CHECK_INTERVAL_HOURS=12
